<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaticinus.forecastbench.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-c</string>
    <string>FORECASTBENCH_USE_OPUS=0 FORECASTBENCH_USE_LLM_FILL=0 FORECASTBENCH_FETCH_TRIES=20 FORECASTBENCH_FETCH_SLEEP=30 /Users/emizemani/.forecastbench-runtime/data/metaculus/run_forecastbench_due_window.sh &gt;&gt; /tmp/forecastbench_poll.log 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/tmp/forecastbench_poll_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/forecastbench_poll_launchd.err</string>
</dict>
</plist>
