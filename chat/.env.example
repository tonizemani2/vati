# Vaticinus chat — environment.
# Local dev: copy to .env.local (gitignored). Production: set as Cloudflare Worker
# secrets/vars (see wrangler.jsonc). Provider keys (DEEPSEEK_API_KEY etc.) are also read
# from the repo-root .env in local dev as a convenience.

# --- Neon Postgres (required for history + record + saved cards) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Model provider (one of) ---
DEEPSEEK_API_KEY=
# VATI_CHAT_PROVIDER=openrouter   # OPENROUTER_API_KEY
# VATI_CHAT_PROVIDER=minimax      # MINIMAX_API_KEY + MINIMAX_BASE_URL
# VATI_CHAT_MODEL=deepseek-v4-pro

# --- Clerk auth (optional locally; set in prod to require sign-in) ---
# Keys from dashboard.clerk.com -> API keys. When the secret key is present the API routes
# gate signed-out callers; when absent the app runs open as user 'anon'. The publishable key
# (NEXT_PUBLIC_) is inlined into the client bundle and mounts the sign-in UI.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# --- Stripe (credit packs; optional until you want to charge) ---
# Test keys from dashboard.stripe.com/test/apikeys. The webhook secret comes from the
# endpoint you create at /webhooks (event: checkout.session.completed) or `stripe listen`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VATI_PUBLIC_ORIGIN=https://chat.vaticinus.com   # used for Stripe success/cancel return URLs

# --- Council / credit tunables (optional; sensible defaults baked in) ---
# VATI_FREE_COUNCIL=3        # free council runs per user per month
# VATI_COST_COUNCIL=1        # credits per council run once the free allowance is used
# VATI_COST_DEEP=4           # credits per deep run
# VATI_COUNCIL_FLASH=deepseek-v4-flash   # model for the parallel analysts (cheap)
# VATI_COUNCIL_PRO=deepseek-v4-pro       # model for the gate + synthesis

# --- Cloudflare security ---
# Keep workers_dev=false in wrangler.jsonc so traffic stays on chat.vaticinus.com.
